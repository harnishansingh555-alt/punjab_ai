# Copy these into Render > Environment (never put real keys in files on GitHub).
PORT=3000

# Google sign-in (the Client ID is public)
GOOGLE_CLIENT_ID=737468148049-supdkq5jetbuphutlon3ku04f1cmb03s.apps.googleusercontent.com

# Chat order: Claude, then Gemini, then Groq, then AI Horde (free but slow) as the last backup.
# Whichever keys you add are used automatically. Optional: CHAT_PROVIDER=gemini forces a first choice.
# AI Horde is also used to create pictures. Get a key at aihorde.net
HORDE_API_KEY=your-ai-horde-key

# Reads pictures and PDFs (free key from aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key

# Optional extras: GROQ_API_KEY is a very fast free backup
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# Chat is blocked without Google sign-in. Use false only on your own computer for testing.
# REQUIRE_LOGIN=true

# Email sign-in (6-digit code by Resend) and the free API key page.
# Put the real Resend key ONLY in Render > Environment, never in a file or on GitHub.
# RESEND_API_KEY=re_xxxxxxxx
# Until you verify your domain at resend.com/domains, use the default sender and send only to your own email.
# After verifying Punjab-ai.website, set:  RESEND_FROM=Punjab AI <login@punjab-ai.website>
# RESEND_FROM=
# Show the login page first to visitors who are not signed in (set false to turn off).
# LOGIN_FIRST=true
# Free API key: requests per day for each key.
# API_DAILY_LIMIT=50
# Free API key: pictures per day for each key (pictures are slower and use the free AI Horde service).
# API_IMAGE_DAILY_LIMIT=10
# Folder where API keys are saved. On Render, attach a Disk and set this to its path (for example /var/data) or keys are lost on redeploy.
# DATA_DIR=
