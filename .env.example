# Copy these into Render > Environment (never put real keys in files on GitHub).
PORT=3000

# Google sign-in (the Client ID is public)
GOOGLE_CLIENT_ID=737468148049-supdkq5jetbuphutlon3ku04f1cmb03s.apps.googleusercontent.com

# Chat order: Claude, then Gemini, then Groq, then AI Horde (free but slow) as the last backup.
# Whichever keys you add are used automatically. Optional: CHAT_PROVIDER=gemini forces a first choice.
# AI Horde is also used to create pictures. Get a key at aihorde.net
HORDE_API_KEY=your-ai-horde-key

# Reads pictures and PDFs (free key from aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key

# Optional extras: GROQ_API_KEY is a very fast free backup
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# Chat is blocked without Google sign-in. Use false only on your own computer for testing.
# REQUIRE_LOGIN=true
